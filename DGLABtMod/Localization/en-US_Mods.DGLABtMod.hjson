Configs: {
	MainConfig: {
		DisplayName: Client Config

		Headers: {
			重要安全警示: Important Safety Warnings
			通道设置（务必同时在APP中设置强度上限！！）: Channel Settings(Must set max strength in the app!)
			强度设置: Strength Settings
			服务设置: Server Settings
			UI设置: UI Settings
			调试选项: Debugging Options
		}

		WARN: {
			Label: You are 18+ years old and PROVIDED TRUTHFUL INFORMATION IN THIS INTERFACE.
			Tooltip: ""
		}

		WARN1: {
			Label: You have read and agreed to the Disclaimer & DG-LAB Safety Precautions (hover to preview).
			Tooltip:
				'''
				DG-LAB Safety Precautions Summary:

				a) You have read and understood the manufacturer's safety guidelines.
				b) Strictly prohibited for:Persons with pacemakers, heart conditions, 
				epilepsy, or sensory disordersPregnant individuals, minors, or anyone
				unable to operate the device promptly
				c) Use only on safe body areas (e.g., limbs). Never near the head, chest, or heart.
				d) Always start at the lowest strength and adjust within your personal tolerance range.

				The full safety manual is available in the DG-LAB app settings.

				'''
		}

		WARN2: {
			Label: You have no heart/neurological conditions and consulted a doctor if needed.
			Tooltip: ""
		}

		WARN3: {
			Label: You are using only unmodified DG-LAB 3.0 official devices.
			Tooltip: ""
		}

		WARN4: {
			Label: Your strength settings are within safe limits,and you accept all risks.
			Tooltip: ""
		}

		A: {
			Label: Enable Channel A
			Tooltip:
				'''
				Recommended Value:Enable
				Decide whether to enable this channel
				'''
		}

		MaxA: {
			Label: Channel A Strength Upper Limit
			Tooltip:
				'''
				Recommended Value:100
				Set a strength limit for this channel, the official maximum is 200
				If the real-time strength is greater than this value,
				the actual strength is equal to this value
				For example, when the maximum value is 100 but the strength has reached 120,
				the output strength is equal to 100
				'''
		}

		LowA: {
			Label: Channel A Strength Lower limit
			Tooltip:
				'''
				Recommended Value:0
				Set a minimum strength limit for this channel, with an official maximum of 200
				If the real-time strength is less than this value,
				the actual strength is equal to this value
				For example, if the minimum value is 20 but the strength has reached 10,
				the output strength is equal to 20
				'''
		}

		B: {
			Label: Enable channel B
			Tooltip:
				'''
				Recommended Value:Enable
				Decide whether to enable this channel
				'''
		}

		MaxB: {
			Label: Channel B Strength Upper Limit
			Tooltip:
				'''
				Recommended Value:100
				Set a strength limit for this channel, the official maximum is 200
				If the real-time strength is greater than this value,
				the actual strength is equal to this value
				For example, when the maximum value is 100 but the strength has reached 120,
				the output strength is equal to 100
				'''
		}

		LowB: {
			Label: Channel B Strength Lower limit
			Tooltip:
				'''
				Recommended Value:0
				Set a minimum strength limit for this channel, with an official maximum of 200
				If the real-time strength is less than this value,
				the actual strength is equal to this value
				For example, if the minimum value is 20 but the strength has reached 10,
				the output strength is equal to 20
				'''
		}

		CommStrength: {
			Label: Increased Strength For Every 10 Normal Damage
			Tooltip:
				'''
				Recommended Value:3
				Used to set how much strength increases after every ten damage taken
				For example, when taking 42 normal damage,
				if set to 3, it will increase strength by 12.6

				Normal damage is damage that causes the player to cry out when hit
				Such as zombie damage, fall damage, and magma direct damage
				Debuff damage is not within normal damage
				'''
		}

		BuffStrength: {
			Label: Buffs Damage Strength Per Second
			Tooltip:
				'''
				Recommended Value:3
				Used to set how much strength increases per second when such a buff status is obtained

				Buff damage refers to Burning,
				Poisoned and other types of buff damage that will hurt but are not strong
				See this Mod README.md for details
				'''
		}

		BuffPlusStrength: {
			Label: Strong Buffs Damage Strength Per Second
			Tooltip:
				'''
				Recommended Value:6
				Used to set how much strength increases per second when such a buff status is obtained

					
				Acid Venom and Electrified(Empathy!)and other buffs belong Strong Buffs
				See this Mod README.md for details
				'''
		}

		BuffTroubleStrength: {
			Label: Interference Buff Increases Strength
			Tooltip:
				'''
				Recommended Value:10
				Used to set how much strength is added to the current strength when obtaining such a buff state,
				and it will not be stacked repeatedly

					
				The Tongue and Weak and other buffs belong Interference Buff
				See this Mod README.md for details
				'''
		}

		Death: {
			Label: Strength At Death
			Tooltip:
				'''
				Recommended Value:90
				Fixed strength when it belongs to the death interface
				Reverts to 0 immediately after respawning
				See this Mod README.md for details
				'''
		}

		DeathTime: {
			Label: Penalty Time Upon Death(1/60 second)
			Tooltip:
				'''
				Set how long the output will last after death.
				If set to 0, it means that it will always output on the death interface
				'''
		}

		WaitTime: {
			Label: Strength Drop Wait Time
			Tooltip:
				'''
				Used to set how many seconds to wait after
				taking damage before starting to drop in strength.
				Recommended Value:10
				'''
		}

		Speed: {
			Label: The Rate Of Strength Decline
			Tooltip:
				'''
				Used to set how much strength to drop per second
				Recommended Value:3
				'''
		}

		SpeedBuff: {
			Label: Normal HP Regeneration Buff Strength Decay Rate
			Tooltip:
				'''
				Used to set how much the normal HP regeneration
				buff decreases per second
				Recommended Value:2
				'''
		}

		SpeedBuffPlus: {
			Label: Strong HP Regeneration Buff Strength Decay Rate
			Tooltip:
				'''
				Used to set how much the strong HP regeneration
				buff decreases per second
				Recommended Value:6
				'''
		}

		Port: {
			Label: Service Startup port
			Tooltip:
				'''
				Recommended Value:9999
				If you are unable to generate QR code,
				you can try modifying this value
				(It needs to be between 1024-65535)
				'''
		}

		IP: {
			Label: QR Code Connection Address
			Tooltip:
				'''
				It is recommended to leave it blank,
				If left blank, the local network IP of
				this computer will be automatically detected.
				If connection fails, try manually entering an IP address
				(Ensure the IP matches this computer's LAN address,
				typically 192.168.x.xxx - find it in your home router admin panel)
				See this Mod README.md for details
				'''
		}

		IsDebug: {
			Label: Enable Debugging
			Tooltip:
				'''
				When checked, a prompt will be generated whenever an injury or death occurs
				HIGHLY NOT RECOMMENDED TO ENABLE
				See this Mod README.md for details
				'''
		}

		DebugBuff: {
			Label: Debugging Options: Displays the Buff Effect
			Tooltip:
				'''
				When checked, a prompt will be generated when a buff damage event occurs,
				provided that "Enable Debugging" is enabled
				HIGHLY NOT RECOMMENDED TO ENABLE
				See this Mod README.md for details
				'''
		}

		UIx: {
			Label: UI Horizontal Position
			Tooltip:
				'''
				Recommended Value:500
				Set the position of the strength display panel horizontally,
				with values ranging from 0 to 1000
				500 is center, 0 is the leftmost one
				'''
		}

		UIy: {
			Label: UI Vertical Position
			Tooltip:
				'''
				Recommended Value:10
				Set the position of the strength display panel in the vertical direction,
				with values ranging from 0 to 1000
				500 is the center, 0 is the top
				'''
		}

		DollMode: {
			Label: Voodoo Doll Mode
			Tooltip:
				'''
				When checked,in multiplayer mode, when other players are injured or die,
				it will shock you,for entertainment only,
				it is not recommended to turn it on
				(Bugs left over from the old version)
				'''
		}

		HideUI: {
			Label: Hide UI
			Tooltip: ""
		}

		QrPath: {
			Label: QR Code Saves Path
			Tooltip:
				'''
				It is recommended to leave it blank,
				If left blank, it will be saved in the picture folder.
				If you cannot generate a QR code, you can try to modify it
				(The best way to modify is the absolute path
				Such as"D:\QrPath",this will save at"D:\QrPath\DGLAB_tMod_QRCode.png")
				'''
		}
	}
}
